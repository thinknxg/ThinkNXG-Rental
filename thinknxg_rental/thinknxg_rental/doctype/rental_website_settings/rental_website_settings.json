 "fields": [
  {
   "fieldname": "tab_general",
   "fieldtype": "Tab Break",
   "label": "General"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Website Enabled",
   "default": "1",
   "description": "Publishes the public rental website at /hire."
  },
  {
   "fieldname": "use_as_home_page",
   "fieldtype": "Check",
   "label": "Use as the Site's Home Page",
   "description": "Sets Website Settings > Home Page to the rental website, so it opens at the site's address."
  },
  {
   "fieldname": "site_name",
   "fieldtype": "Data",
   "label": "Website Name",
   "default": "thinkNXG Rental"
  },
  {
   "fieldname": "tagline",
   "fieldtype": "Data",
   "label": "Tagline",
   "default": "Intelligent Rental Operations Platform"
  },
  {
   "fieldname": "logo",
   "fieldtype": "Attach Image",
   "label": "Logo",
   "description": "Left empty, the thinkNXG Rental mark is used."
  },
  {
   "fieldname": "cb_g1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "show_prices",
   "fieldtype": "Check",
   "label": "Show Rental Rates and Estimates",
   "description": "Standard rates (rate card or Rental Item Profile) and an estimate for the dates entered. Customers' own rate cards apply when they are logged in."
  },
  {
   "fieldname": "show_availability",
   "fieldtype": "Check",
   "label": "Show Availability",
   "default": "1",
   "description": "In stock / Limited / On request, from free own stock in the active rental warehouses after reservations. Quantities are never shown."
  },
  {
   "fieldname": "limited_threshold",
   "fieldtype": "Int",
   "label": "Limited Below",
   "default": "20",
   "depends_on": "show_availability",
   "description": "Free stock below this number shows as Limited."
  },
  {
   "fieldname": "allow_purchase_enquiries",
   "fieldtype": "Check",
   "label": "Allow Purchase Enquiries",
   "default": "1",
   "description": "Items marked Available for Purchase can be added to the basket to buy."
  },
  {
   "fieldname": "enquiry_notify_role",
   "fieldtype": "Link",
   "label": "Notify Role of New Enquiries",
   "options": "Role",
   "default": "Rental Manager"
  },
  {
   "fieldname": "tab_design",
   "fieldtype": "Tab Break",
   "label": "Design"
  },
  {
   "fieldname": "template",
   "fieldtype": "Select",
   "label": "Template",
   "options": "Industrial Corporate\nModern Minimal\nPremium Construction\nEnterprise Rental\nEquipment Catalogue Focus",
